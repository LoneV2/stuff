local function ToggleButtonVisual(btn, active)
	btn.BackgroundColor3 = active and Color3.fromRGB(32, 95, 65) or Color3.fromRGB(26, 31, 44)
	btn.BackgroundTransparency = active and 0.05 or 0.1
	btn.TextColor3 = active and Color3.fromRGB(245, 255, 250) or Color3.fromRGB(235, 240, 250)
	local stroke = btn:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = active and Color3.fromRGB(50, 140, 95) or Color3.fromRGB(52, 62, 85)
	end
end

