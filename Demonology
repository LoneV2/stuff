local function CheckInventory(ItemName)
	for _, obj in ipairs(plr.PlayerGui.Hotbar.Slots:GetChildren()) do
		if obj:IsA("Frame") and string.find(string.lower(obj.Name), "invslot") then
			if obj.ItemName.Text == ItemName then
				return true, tonumber(obj.Name:match("%d+"))
			end
		end
	end
	return false, nil
end

local function FindItem(ItemName)
	local items = workspace:FindFirstChild("Items")
	if items then
		for _, v in ipairs(items:GetChildren()) do
			if v:IsA("Model") and v:GetAttribute("ItemName") == ItemName then
				return true, v
			end
		end
	end
	return false, nil
end

local function ActiveItem()
	local Chara = plr.Character
	if Chara then
		for _, v in pairs(Chara:GetChildren()) do
			if v:IsA("Model") or tonumber(v.Name) then
				if v:GetAttribute("Enabled") ~= true and v:FindFirstChild("Handle") then
					ToggleItemState:FireServer(v)
					return true, v
				end
			end
		end
	end
	return false, nil
end

local function EquipItem(SlotNum)
	RequestItemEquip:FireServer("InvSlot" .. tostring(SlotNum))
	return true
end

local function PickupItem(Model)
	RequestItemPickup:FireServer(Model)
	return true
end

local function DropItem(SlotNum)
	RequestItemDrop:FireServer("InvSlot" .. tostring(SlotNum))
	return true
end

local function TpOutside()
	pcall(function()
		local map = workspace:FindFirstChild("Map")
		local rooms = map and map:FindFirstChild("Rooms")
		local baseCamp = rooms and rooms:FindFirstChild("Base Camp")
		local targetPart = nil
		if baseCamp then
			local pegboard = baseCamp:FindFirstChild("Pegboard")
			targetPart = (pegboard and pegboard:FindFirstChild("Union")) or baseCamp:FindFirstChild("Table") or baseCamp:FindFirstChild("Truck") or baseCamp:FindFirstChild("BoundingBox")
			if not targetPart then
				for _, c in ipairs(baseCamp:GetChildren()) do
					if c:IsA("BasePart") then
						targetPart = c
						break
					elseif c:IsA("Model") and c.PrimaryPart then
						targetPart = c.PrimaryPart
						break
					end
				end
			end
		end
		local char = plr.Character or plr.CharacterAdded:Wait()
		if targetPart and char and char:FindFirstChild("HumanoidRootPart") then
			char.HumanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 4, 0)
		end
	end)
end

