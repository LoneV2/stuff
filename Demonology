local function TrackTemp()
	local Temp = 100
	local TempRoom = nil
	local rooms = GetRoomsFolder()
	if rooms then
		for _, room in ipairs(rooms:GetChildren()) do
			local rTemp = room:GetAttribute("Temperature")
			if rTemp ~= nil and rTemp < Temp then
				Temp = rTemp
				TempRoom = room
			end
		end
	end
	return Temp, TempRoom
end

local function CheckWither()
	local items = workspace:FindFirstChild("Items")
	if items then
		for _, obj in ipairs(items:GetDescendants()) do
			if obj:IsA("BasePart") and obj.Name == "Petals" then
				if obj.Color == Color3.new(0, 0, 0) or (obj.Color.R < 0.05 and obj.Color.G < 0.05 and obj.Color.B < 0.05) then
					return true
				end
			end
		end
	end
	return false
end

local function CheckGhostWriting()
	local items = workspace:FindFirstChild("Items")
	if items then
		for _, obj in ipairs(items:GetDescendants()) do
			if obj:IsA("Decal") then
				local model = obj:FindFirstAncestorWhichIsA("Model")
				if model and model:GetAttribute("ItemName") == "Spirit Book" then
					if obj.Texture ~= "" and obj.Texture ~= nil then
						return true
					end
				end
			end
		end
	end
	return false
end

local function CheckHandprints()
	local hp = workspace:FindFirstChild("Handprints")
	if hp and #hp:GetChildren() > 0 then
		return true
	end
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and (
			obj.Name == "Handprint1" or
			obj.Name == "Handprint2" or
			obj.Name == "Footprint" or
			obj.Name == "Footprint1"
		) then
			return true
		end
	end
	return false
end

local function CheckGhostOrb()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name == "GhostOrb" then
			return true
		end
	end
	return false
end

local function CheckEMF()
	local level = 0
	local ghost = GetGhostModel()
	if ghost and ghost:GetAttribute("LastEMFLevel5Time") then
		return 5
	end
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Folder") and obj.Name == "Indicators" then
			for _, v in pairs(obj:GetChildren()) do
				if v:IsA("BasePart") and v.Material == Enum.Material.Neon and tonumber(v.Name) then
					if tonumber(v.Name) > level then
						level = tonumber(v.Name)
					end
				end
			end
		end
	end
	return level
end

local function CheckSpiritBox()
	local sub = plr.PlayerGui:FindFirstChild("Subtitles")
	local textLabel = sub and sub.Holder:FindFirstChild("TextLabel")
	if textLabel then
		local ghostText = textLabel.Text
		return #ghostText:gsub("%s+", "") >= 3
	end
	return false
end

local function GetPossibleGhostTypes(detectedList)
	local matches = {}
	for ghostName, evidences in pairs(GhostEvidenceMap) do
		local allMatch = true
		for _, det in ipairs(detectedList) do
			if not table.find(evidences, det) then
				allMatch = false
				break
			end
		end
		if allMatch then
			table.insert(matches, ghostName)
		end
	end
	return matches
end

local function SelectEvidenceInJournal(evidenceName)
	pcall(function()
		local journal = plr.PlayerGui:FindFirstChild("Journal")
		local page4 = journal and journal:FindFirstChild("Holder") and journal.Holder.Pages:FindFirstChild("Page4")
		if page4 then
			local evTypes = page4.Left.Page.EvidenceTypes
			local evFrame = evTypes:FindFirstChild(evidenceName)
			if evFrame and evFrame:FindFirstChild("Container") and evFrame.Container:FindFirstChild("Detection") then
				local conn = getconnections and getconnections(evFrame.Container.Detection.MouseButton1Click)[1]
				if conn and getupvalues then
					local u1 = getupvalues(conn.Function)[1]
					if u1 then u1[evidenceName] = true end
				end
			end
		end
	end)

	pcall(function()
		if EvidenceMarkedInJournal then
			EvidenceMarkedInJournal:FireServer(evidenceName)
		end
	end)

	pcall(function()
		local journal = plr.PlayerGui:FindFirstChild("Journal")
		if journal and journal:FindFirstChild("Holder") and journal.Holder.Pages then
			for _, pageName in ipairs({"Page1", "Page4"}) do
				local p = journal.Holder.Pages:FindFirstChild(pageName)
				if p and p:FindFirstChild("Left") and p.Left:FindFirstChild("Page") then
					local et = p.Left.Page:FindFirstChild("EvidenceTypes")
					if et then
						local evFrame = et:FindFirstChild(evidenceName)
						if evFrame then
							local target = evFrame:FindFirstChild("Container") or evFrame
							if target:FindFirstChild("Highlight") then target.Highlight.Visible = true end
							if target:FindFirstChild("CrossOut") then target.CrossOut.Visible = false end
						end
					end
				end
			end
		end
	end)
end

local function SelectGhostInJournal(ghostName)
	if not ghostName or ghostName == "..." or ghostName:find("/") or ghostName:find("%+") then
		return false
	end

	pcall(function()
		local journal = plr.PlayerGui:FindFirstChild("Journal")
		local page4 = journal and journal:FindFirstChild("Holder") and journal.Holder.Pages:FindFirstChild("Page4")
		if page4 then
			local ghostTypes = page4.Right.Page.GhostTypes
			local targetFrame = ghostTypes:FindFirstChild(ghostName)
			if targetFrame and targetFrame:FindFirstChild("Detection") then
				local conn = getconnections and getconnections(targetFrame.Detection.MouseButton1Click)[1]
				if conn and getupvalues then
					local u2 = getupvalues(conn.Function)[1]
					if u2 then
						for k in pairs(u2) do u2[k] = nil end
						u2[ghostName] = true
					end
				end
			end

			for _, g in ipairs(ghostTypes:GetChildren()) do
				if g:IsA("Frame") then
					if g.Name == ghostName then
						if g:FindFirstChild("Highlight") then g.Highlight.Visible = true end
						if g:FindFirstChild("Strikethrough") then g.Strikethrough.Visible = false end
					else
						if g:FindFirstChild("Highlight") and g.Highlight.Visible then
							g.Highlight.Visible = false
						end
					end
				end
			end
		end
	end)

	pcall(function()
		if EvidenceMarkedInJournal then
			EvidenceMarkedInJournal:FireServer(ghostName)
		end
	end)

	return true
end

