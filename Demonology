local function RefreshEvidenceESP()
	if not EvidenceEspToggle then return end

	local function AddPrintESP(obj)
		if obj:IsA("BasePart") and not obj:FindFirstChild("EvidenceBil") then
			local bil = Instance.new("BillboardGui", obj)
			bil.Name = "EvidenceBil"
			bil.AlwaysOnTop = true
			bil.Size = UDim2.new(0, 95, 0, 26)
			bil.Adornee = obj

			local lbl = Instance.new("TextLabel", bil)
			lbl.BackgroundTransparency = 1
			lbl.Size = UDim2.new(1, 0, 1, 0)
			lbl.Font = Enum.Font.GothamBold
			lbl.Text = obj.Name:find("Foot") and "👣 Footprint" or "🖐 Handprint"
			lbl.TextColor3 = Color3.fromRGB(80, 255, 140)
			lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
			lbl.TextStrokeTransparency = 0
			lbl.TextScaled = true

			local h = Instance.new("Highlight", obj)
			h.Name = "EvidenceHL"
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.OutlineColor = Color3.fromRGB(80, 255, 140)
			h.FillTransparency = 1
			h.Adornee = obj

			table.insert(EvidenceEspObjects, bil)
			table.insert(EvidenceEspObjects, h)
		end
	end

	local hpFolder = workspace:FindFirstChild("Handprints")
	if hpFolder then
		for _, obj in ipairs(hpFolder:GetChildren()) do AddPrintESP(obj) end
	end
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and (obj.Name == "Handprint1" or obj.Name == "Handprint2" or obj.Name == "Footprint" or obj.Name == "Footprint1") then
			AddPrintESP(obj)
		end
	end

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name == "GhostOrb" and not obj:FindFirstChild("EvidenceBil") then
			local bil = Instance.new("BillboardGui", obj)
			bil.Name = "EvidenceBil"
			bil.AlwaysOnTop = true
			bil.Size = UDim2.new(0, 80, 0, 24)
			bil.Adornee = obj

			local lbl = Instance.new("TextLabel", bil)
			lbl.BackgroundTransparency = 1
			lbl.Size = UDim2.new(1, 0, 1, 0)
			lbl.Font = Enum.Font.GothamBold
			lbl.Text = "✨ Ghost Orb"
			lbl.TextColor3 = Color3.fromRGB(240, 245, 255)
			lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
			lbl.TextStrokeTransparency = 0
			lbl.TextScaled = true

			local h = Instance.new("Highlight", obj)
			h.Name = "EvidenceHL"
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.OutlineColor = Color3.fromRGB(240, 245, 255)
			h.FillTransparency = 1
			h.Adornee = obj

			table.insert(EvidenceEspObjects, bil)
			table.insert(EvidenceEspObjects, h)
		end
	end
end

local function ClearEvidenceESP()
	for _, inst in ipairs(EvidenceEspObjects) do
		pcall(function() inst:Destroy() end)
	end
	table.clear(EvidenceEspObjects)
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:FindFirstChild("EvidenceBil") then pcall(function() obj.EvidenceBil:Destroy() end) end
		if obj:FindFirstChild("EvidenceHL") then pcall(function() obj.EvidenceHL:Destroy() end) end
	end
end

