-- Noclip Handler
local function SetNoclip(state)
	NoclipToggle = state
	ToggleButtonVisual(NoclipBtn, NoclipToggle)
	if NoclipToggle then
		if not NoclipConn then
			NoclipConn = RS.Stepped:Connect(function()
				if NoclipToggle and plr.Character then
					for _, part in ipairs(plr.Character:GetDescendants()) do
						if part:IsA("BasePart") and part.CanCollide then
							part.CanCollide = false
						end
					end
				end
			end)
		end
	else
		if NoclipConn then
			NoclipConn:Disconnect()
			NoclipConn = nil
		end
		if plr.Character then
			for _, part in ipairs(plr.Character:GetDescendants()) do
				if part:IsA("BasePart") and (part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso") then
					part.CanCollide = true
				end
			end
		end
	end
end

