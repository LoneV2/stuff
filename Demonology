	while not IsUiClosed do
		task.wait(0.5)
		if AutoSpiritBoxToggle then
			local ghost = GetGhostModel()
			if ghost and ghost:GetAttribute("Hunting") == true then
				TpOutside()
			else
				local char = plr.Character
				if char and ghost and char:FindFirstChild("HumanoidRootPart") then
					char.HumanoidRootPart.CFrame = ghost:GetPivot() * CFrame.new(0, 0, 10)
					
					local hasItem, slot = CheckInventory("Spirit Box")
					if not hasItem then
						local found, itemModel = FindItem("Spirit Box")
						if found and itemModel then
							PickupItem(itemModel)
							task.wait(0.3)
							ActiveItem()
							task.wait(0.4)
							local hasItem2, slot2 = CheckInventory("Spirit Box")
							if hasItem2 then
								EquipItem(slot2)
								task.wait(0.3)
								FireSpiritBox()
							end
						end
					else
						EquipItem(slot)
						ActiveItem()
						task.wait(0.3)
						FireSpiritBox()
					end
				end
			end
		end
	end
end)

