-- Infinite Stamina Handler
local function SetInfStamina(state)
	InfStaminaToggle = state
	ToggleButtonVisual(InfStaminaBtn, InfStaminaToggle)
	if InfStaminaToggle then
		if not InfStaminaConn then
			InfStaminaConn = RS.RenderStepped:Connect(function()
				if InfStaminaToggle then
					local maxStamina = workspace:GetAttribute("MaxStamina") or 100
					pcall(function() plr:SetAttribute("Stamina", maxStamina) end)

					pcall(function()
						local hud = plr.PlayerGui:FindFirstChild("HUD")
						local stamina = hud and hud:FindFirstChild("Stamina")
						local bar = stamina and stamina:FindFirstChild("Bar")
						if bar then
							bar.Size = UDim2.new(1, 0, 1, 0)
						end
					end)

					pcall(function()
						local mc = plr.PlayerScripts:FindFirstChild("MovementController")
						if mc and getsenv and getupvalues and setupvalue then
							local env = getsenv(mc)
							if env.StartSprint then
								setupvalue(env.StartSprint, 2, maxStamina)
							end
						end
					end)
				end
			end)
		end
	else
		if InfStaminaConn then
			InfStaminaConn:Disconnect()
			InfStaminaConn = nil
		end
	end
end

