		if isFreezing then SelectEvidenceInJournal("FreezingTemperatures") end
		if CachedWither then SelectEvidenceInJournal("Wither") end
		if CachedSpiritBox then SelectEvidenceInJournal("SpiritBox") end
		if CachedWriting then SelectEvidenceInJournal("GhostWriting") end
		
		if IsDoppelgangerDetected then
			DeselectEvidenceInJournal("GhostOrb")
		elseif CachedOrb then
			SelectEvidenceInJournal("GhostOrb")
		end
	end

	-- Auto Select Ghost Execution (Only fires once per identified ghost)
	if AutoSelectGhostToggle and detectedGhostType and detectedGhostType ~= "..." and not detectedGhostType:find("/") and not detectedGhostType:find("%+") then
		local cleanName = detectedGhostType:gsub("%s*%(.*%)", "")
		if LastAutoSelectedGhost ~= cleanName then
			LastAutoSelectedGhost = cleanName
			SelectGhostInJournal(cleanName)
		end
	end

	-- Header Info
	local hunting = ghost and ghost:GetAttribute("Hunting") == true
	local gender = ghost and ghost:GetAttribute("Gender") or "..."
	local age = ghost and ghost:GetAttribute("Age") or 0
	local favRoom = ghost and ghost:GetAttribute("FavoriteRoom") or "..."
	local curRoom = ghost and ghost:GetAttribute("CurrentRoom") or "..."
	local prefix = hunting and "Ghost(Hunting): " or "Ghost: "

	Ghost.Text = prefix .. gender .. " | Type: " .. detectedGhostType .. " | Age: " .. tostring(age)
	Ghost.TextColor3 = hunting and Color3.fromRGB(235, 75, 75) or (IsDoppelgangerDetected and Color3.fromRGB(245, 195, 75) or Color3.fromRGB(245, 245, 250))
	CurrentRoom.Text = "Current room: " .. curRoom .. " | Favorite room: " .. favRoom

	-- HUD Overlay Header
	HUDGhost.Text = (hunting and "Ghost (Hunting): " or "Ghost: ") .. detectedGhostType
	HUDGhost.TextColor3 = hunting and Color3.fromRGB(235, 75, 75) or (IsDoppelgangerDetected and Color3.fromRGB(245, 195, 75) or Color3.fromRGB(240, 240, 245))
	HUDRoom.Text = "Room: " .. curRoom .. " | Fav: " .. favRoom

	-- Hunt Escape Safety (1-Time Teleport per Hunt)
	if hunting then
		if IsEscapeHunt and not HasEscapedCurrentHunt then
			HasEscapedCurrentHunt = true
			TpOutside()
		end
	else
		HasEscapedCurrentHunt = false
	end

	-- Evidence ESP Refresh (Targeted)
	if EvidenceEspToggle then
		RefreshEvidenceESP()
	end

	-- Player Energy Sync
	local energyEntries = {}
	for _, p in pairs(PS:GetPlayers()) do
		if p:GetAttribute("Energy") ~= nil then
			local energy = tostring(math.floor(p:GetAttribute("Energy")))
			local name = p.Name == p.DisplayName and p.Name or p.Name .. " (" .. p.DisplayName .. ")"
			table.insert(energyEntries, name .. ": " .. energy .. "%")
		end
	end
	EnergyText.Text = #energyEntries > 0 and ("Player energy: " .. table.concat(energyEntries, "  |  ")) or "Player energy: N/A"

	-- Player ESP Sync
	if PlayersEspToggle then
		for _, p in pairs(PS:GetPlayers()) do
			if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local HRP = p.Character.HumanoidRootPart
				local Bil = HRP:FindFirstChild("HubPlrBil")
				local H = HRP:FindFirstChild("HubPlrEsp")

				if not Bil then
					Bil = Instance.new("BillboardGui", HRP)
					Bil.Name = "HubPlrBil"
					Bil.AlwaysOnTop = true
					Bil.Size = UDim2.new(0, 100, 0, 36)
					Bil.Adornee = HRP

					local lbl = Instance.new("TextLabel", Bil)
					lbl.BackgroundTransparency = 1
					lbl.Size = UDim2.new(1, 0, 1, 0)
					lbl.Font = Enum.Font.GothamBold
					lbl.TextColor3 = Color3.fromRGB(120, 190, 240)
					lbl.TextStrokeColor3 = Color3.fromRGB(15, 15, 20)
					lbl.TextStrokeTransparency = 0.3
					lbl.TextScaled = true
					lbl.Text = p.DisplayName

					H = Instance.new("Highlight", HRP)
					H.Name = "HubPlrEsp"
					H.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					H.OutlineColor = Color3.fromRGB(120, 190, 240)
					H.FillTransparency = 1
					H.Adornee = p.Character
				end
			end
		end
	end
end)

