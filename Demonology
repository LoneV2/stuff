-- Permanent Evidence Latches
local LowestRecordedTemp = 100
local HighestEMFLevel = 1
local CachedWither = false
local CachedWriting = false
local CachedPrints = false
local CachedOrb = false
local CachedLaser = false
local CachedSpiritBox = false

local PollInterval = 0.35
local LastPollTick = tick()

local MainLoopConn = RS.Heartbeat:Connect(function()
	local now = tick()
	if now - LastPollTick < PollInterval then return end
	LastPollTick = now

	local ghost = GetGhostModel()

	ModeText.Text = "Difficulty: " .. tostring(workspace:GetAttribute("Difficulty") or "Unknown")
	Take3StarsPhoto.Text = "Take 3 stars photo (" .. tostring(workspace:GetAttribute("PhotosTaken") or 0) .. "/6)"

	-- 1. Temperature (Permanent Latch)
	local currentLowest, tempRoom = TrackTemp()
	if currentLowest and currentLowest < LowestRecordedTemp then
		LowestRecordedTemp = currentLowest
	end
	local isFreezing = LowestRecordedTemp < 0
	local tempStr = string.format("Temperature: %.1f°C", LowestRecordedTemp < 100 and LowestRecordedTemp or 0)
	local tempColor = isFreezing and Color3.fromRGB(85, 215, 130) or Color3.fromRGB(205, 95, 95)
	Temperature.Text = tempStr
	Temperature.TextColor3 = tempColor
	HUD_Temperature.Text = tempStr
	HUD_Temperature.TextColor3 = tempColor

	-- 2. Wither (Permanent Latch)
	if not CachedWither and CheckWither() then CachedWither = true end
	local witherStr = "Wither: " .. (CachedWither and "Yes" or "No")
	local witherColor = CachedWither and Color3.fromRGB(85, 215, 130) or Color3.fromRGB(205, 95, 95)
	Wither.Text = witherStr
	Wither.TextColor3 = witherColor
	HUD_Wither.Text = witherStr
	HUD_Wither.TextColor3 = witherColor

	-- 3. Ghost Writing (Permanent Latch)
	if not CachedWriting and CheckGhostWriting() then CachedWriting = true end
	local writingStr = "Ghost Writing: " .. (CachedWriting and "Yes" or "No")
	local writingColor = CachedWriting and Color3.fromRGB(85, 215, 130) or Color3.fromRGB(205, 95, 95)
	GhostWriting.Text = writingStr
	GhostWriting.TextColor3 = writingColor
	HUD_GhostWriting.Text = writingStr
	HUD_GhostWriting.TextColor3 = writingColor

	-- 4. Handprints (Permanent Latch)
	if not CachedPrints and CheckHandprints() then CachedPrints = true end
	local printsStr = "Handprints: " .. (CachedPrints and "Yes" or "No")
	local printsColor = CachedPrints and Color3.fromRGB(85, 215, 130) or Color3.fromRGB(205, 95, 95)
	Handprints.Text = printsStr
	Handprints.TextColor3 = printsColor
	HUD_Handprints.Text = printsStr
	HUD_Handprints.TextColor3 = printsColor

	-- 5. Ghost Orb (Permanent Latch)
	if not CachedOrb and CheckGhostOrb() then CachedOrb = true end
	local orbStr = "Ghost Orb: " .. (CachedOrb and "Yes" or "No")
	local orbColor = CachedOrb and Color3.fromRGB(85, 215, 130) or Color3.fromRGB(205, 95, 95)
	GhostOrb.Text = orbStr
	GhostOrb.TextColor3 = orbColor
	HUD_GhostOrb.Text = orbStr
	HUD_GhostOrb.TextColor3 = orbColor

	-- 6. EMF (Permanent Latch to Highest)
	local currentEMF = CheckEMF()
	if currentEMF > HighestEMFLevel then HighestEMFLevel = currentEMF end
	local isEMF5 = HighestEMFLevel == 5
	local emfStr = "EMF level: " .. tostring(HighestEMFLevel)
	local emfColor = isEMF5 and Color3.fromRGB(85, 215, 130) or Color3.fromRGB(205, 95, 95)
	EMF.Text = emfStr
	EMF.TextColor3 = emfColor
	HUD_EMF.Text = emfStr
	HUD_EMF.TextColor3 = emfColor

	-- 7. Laser Projector (Permanent Latch)
	if not CachedLaser and ghost and ghost:GetAttribute("InLaser") == true then
		CachedLaser = true
	end
	local laserStr = "Laser Projector: " .. (CachedLaser and "Yes" or "No")
	local laserColor = CachedLaser and Color3.fromRGB(85, 215, 130) or Color3.fromRGB(205, 95, 95)
	LaserProjector.Text = laserStr
	LaserProjector.TextColor3 = laserColor
	HUD_LaserProjector.Text = laserStr
	HUD_LaserProjector.TextColor3 = laserColor

	-- 8. Spirit Box (Permanent Latch)
	if not CachedSpiritBox and CheckSpiritBox() then
		CachedSpiritBox = true
	end
	local spiritStr = "Spirit Box: " .. (CachedSpiritBox and "Yes" or "No")
	local spiritColor = CachedSpiritBox and Color3.fromRGB(85, 215, 130) or Color3.fromRGB(205, 95, 95)
	SpiritBox.Text = spiritStr
	SpiritBox.TextColor3 = spiritColor
	HUD_SpiritBox.Text = spiritStr
	HUD_SpiritBox.TextColor3 = spiritColor

	-- Auto Evidence Execution
	if AutoEvidenceToggle then
		if CachedPrints then SelectEvidenceInJournal("Handprints") end
		if CachedOrb then SelectEvidenceInJournal("GhostOrb") end
		if CachedLaser then SelectEvidenceInJournal("LaserProjector") end
		if isEMF5 then SelectEvidenceInJournal("EMFLevel5") end
		if isFreezing then SelectEvidenceInJournal("FreezingTemperatures") end
		if CachedWither then SelectEvidenceInJournal("Wither") end
		if CachedSpiritBox then SelectEvidenceInJournal("SpiritBox") end
		if CachedWriting then SelectEvidenceInJournal("GhostWriting") end
	end

	-- Ghost Type Resolution
	local detectedList = {}
	if CachedPrints then table.insert(detectedList, "Handprints") end
	if CachedOrb then table.insert(detectedList, "GhostOrb") end
	if CachedLaser then table.insert(detectedList, "LaserProjector") end
	if isEMF5 then table.insert(detectedList, "EMFLevel5") end
	if isFreezing then table.insert(detectedList, "FreezingTemperatures") end
	if CachedWither then table.insert(detectedList, "Wither") end
	if CachedSpiritBox then table.insert(detectedList, "SpiritBox") end
	if CachedWriting then table.insert(detectedList, "GhostWriting") end

	local candidates = GetPossibleGhostTypes(detectedList)
	local detectedGhostType = ghost and (ghost:GetAttribute("GhostType") or ghost:GetAttribute("Type"))
	if not detectedGhostType then
		if #candidates == 1 then
			detectedGhostType = candidates[1]
		elseif #candidates > 1 and #detectedList > 0 then
			if #candidates <= 2 then
				detectedGhostType = table.concat(candidates, "/")
			else
				detectedGhostType = candidates[1] .. " (+" .. tostring(#candidates - 1) .. ")"
			end
		else
			detectedGhostType = "..."
		end
	end

	-- Auto Select Ghost Execution
	if AutoSelectGhostToggle and detectedGhostType and detectedGhostType ~= "..." and not detectedGhostType:find("/") and not detectedGhostType:find("%+") then
		SelectGhostInJournal(detectedGhostType)
	end

	-- Header Info (Favorite Room next to Room)
	local hunting = ghost and ghost:GetAttribute("Hunting") == true
	local gender = ghost and ghost:GetAttribute("Gender") or "..."
	local age = ghost and ghost:GetAttribute("Age") or 0
	local favRoom = ghost and ghost:GetAttribute("FavoriteRoom") or "..."
	local curRoom = ghost and ghost:GetAttribute("CurrentRoom") or "..."
	local prefix = hunting and "Ghost(Hunting): " or "Ghost: "

	Ghost.Text = prefix .. gender .. " | Type: " .. detectedGhostType .. " | Age: " .. tostring(age)
	Ghost.TextColor3 = hunting and Color3.fromRGB(235, 75, 75) or Color3.fromRGB(245, 245, 250)
	CurrentRoom.Text = "Current room: " .. curRoom .. " | Favorite room: " .. favRoom

	-- HUD Overlay Header
	HUDGhost.Text = (hunting and "Ghost (Hunting): " or "Ghost: ") .. detectedGhostType
	HUDGhost.TextColor3 = hunting and Color3.fromRGB(235, 75, 75) or Color3.fromRGB(240, 240, 245)
	HUDRoom.Text = "Room: " .. curRoom .. " | Fav: " .. favRoom

	-- Hunt Escape Safety (1-Time Teleport per Hunt)
	if hunting then
		if IsEscapeHunt and not HasEscapedCurrentHunt then
			HasEscapedCurrentHunt = true
			TpOutside()
		end
	else
		HasEscapedCurrentHunt = false
	end

	-- Real-time Evidence ESP Refresh
	if EvidenceEspToggle then
		RefreshEvidenceESP()
	end

	-- Player Energy Sync
	local energyEntries = {}
	for _, p in pairs(PS:GetPlayers()) do
		if p:GetAttribute("Energy") ~= nil then
			local energy = tostring(math.floor(p:GetAttribute("Energy")))
			local name = p.Name == p.DisplayName and p.Name or p.Name .. " (" .. p.DisplayName .. ")"
			table.insert(energyEntries, name .. ": " .. energy .. "%")
		end
	end
	EnergyText.Text = #energyEntries > 0 and ("Player energy: " .. table.concat(energyEntries, "  |  ")) or "Player energy: N/A"

	-- Player ESP Sync
	if PlayersEspToggle then
		for _, p in pairs(PS:GetPlayers()) do
			if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local HRP = p.Character.HumanoidRootPart
				local Bil = HRP:FindFirstChild("HubPlrBil")
				local H = HRP:FindFirstChild("HubPlrEsp")

				if not Bil then
					Bil = Instance.new("BillboardGui", HRP)
					Bil.Name = "HubPlrBil"
					Bil.AlwaysOnTop = true
					Bil.Size = UDim2.new(0, 100, 0, 36)
					Bil.Adornee = HRP

					local lbl = Instance.new("TextLabel", Bil)
					lbl.BackgroundTransparency = 1
					lbl.Size = UDim2.new(1, 0, 1, 0)
					lbl.Font = Enum.Font.GothamBold
					lbl.TextColor3 = Color3.fromRGB(120, 190, 240)
					lbl.TextStrokeColor3 = Color3.fromRGB(15, 15, 20)
					lbl.TextStrokeTransparency = 0.3
					lbl.TextScaled = true
					lbl.Text = p.DisplayName

					H = Instance.new("Highlight", HRP)
					H.Name = "HubPlrEsp"
					H.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					H.OutlineColor = Color3.fromRGB(120, 190, 240)
					H.FillTransparency = 1
					H.Adornee = p.Character
				end
			end
		end
	end
end)

