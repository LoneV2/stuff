-- Fast Single-Pass Target Scan (< 0.15ms total)
local function PerformEvidenceAudit()
	local items = workspace:FindFirstChild("Items")
	local map = workspace:FindFirstChild("Map")
	local rooms = map and map:FindFirstChild("Rooms")
	local handprints = workspace:FindFirstChild("Handprints")
	local ghost = workspace:FindFirstChild("Ghost")

	-- 1. Temperature Check (Rooms only)
	local lowestTemp = 100
	if rooms then
		for _, r in ipairs(rooms:GetChildren()) do
			local t = r:GetAttribute("Temperature")
			if t and t < lowestTemp then lowestTemp = t end
		end
	end

	-- 2. Items Direct Scan (Wither, Writing, EMF)
	local witherFound = false
	local writingFound = false
	local highestEMF = 0

	if items then
		for _, item in ipairs(items:GetChildren()) do
			local iname = item:GetAttribute("ItemName")
			if iname == "Flower Pot" or item.Name:find("Flower") then
				if item:GetAttribute("PhotoRewardType") == "WitheredFlowers" or item:GetAttribute("Withered") == true or item:GetAttribute("Disabled") == true then
					witherFound = true
				end
			elseif iname == "Spirit Book" or item.Name:find("Book") then
				if item:GetAttribute("Written") == true or item:GetAttribute("Disabled") == true or item:GetAttribute("PhotoRewardType") == "GhostWriting" then
					writingFound = true
				end
			elseif iname == "EMF Reader" then
				local ind = item:FindFirstChild("Indicators", true)
				if ind then
					for _, v in ipairs(ind:GetChildren()) do
						if v:IsA("BasePart") and v.Material == Enum.Material.Neon and tonumber(v.Name) then
							local l = tonumber(v.Name)
							if l > highestEMF then highestEMF = l end
						end
					end
				end
			end
		end
	end

	if ghost and ghost:GetAttribute("LastEMFLevel5Time") then
		highestEMF = 5
	end

	-- 3. Handprints (Folder check)
	local printsFound = handprints and (#handprints:GetChildren() > 0) or false

	-- 4. Ghost Orb (Target exact check)
	local orbFound = (workspace:FindFirstChild("GhostOrb") ~= nil) or (workspace:FindFirstChild("Ghost Orb") ~= nil)

	-- 5. Laser Projector
	local laserFound = ghost and (
		ghost:GetAttribute("LaserVisible") == true or
		ghost:GetAttribute("InLaser") == true or
		ghost:GetAttribute("LastLaserTime") ~= nil
	) or false

	-- 6. Spirit Box (Only true if subtitle text is actual ghost spoken words, not sound effect brackets like "> Door Closes <")
	local sub = plr.PlayerGui:FindFirstChild("Subtitles")
	local textLabel = sub and sub.Holder:FindFirstChild("TextLabel")
	local spiritFound = false
	if textLabel and textLabel.Visible and #textLabel.Text > 0 then
		local txt = textLabel.Text
		if not txt:match("^%s*>.*<%s*$") and not txt:find("^>") and not txt:find("<$") then
			local clean = txt:gsub("%s+", "")
			if #clean >= 2 then
				spiritFound = true
			end
		end
	end

	return lowestTemp, witherFound, writingFound, printsFound, orbFound, highestEMF, laserFound, spiritFound
end

-- Smart Ghost Type Resolver with Doppelganger / Fake Orb handling
local function ResolveGhostMatches(detectedList, isOrbPresent, isWriting, isBox, isFreezing)
	local matches = {}
	
	-- 1. Check if Doppelganger signature is met (GhostWriting + SpiritBox + FreezingTemperatures)
	local isDoppel = isWriting and isBox and isFreezing
	if isDoppel then
		table.insert(matches, "Doppelganger")
		return matches, true
	end

	for ghostName, evidences in pairs(GhostEvidenceMap) do
		local allMatch = true
		for _, det in ipairs(detectedList) do
			if not table.find(evidences, det) then
				allMatch = false
				break
			end
		end
		if allMatch then
			table.insert(matches, ghostName)
		end
	end

	-- If Orb is detected with 2 Doppelganger evidences, suggest Doppelganger as a possible mimic candidate
	if isOrbPresent then
		local dopEvCount = (isWriting and 1 or 0) + (isBox and 1 or 0) + (isFreezing and 1 or 0)
		if dopEvCount >= 2 and not table.find(matches, "Doppelganger") then
			table.insert(matches, "Doppelganger (Fake Orb?)")
		end
	end

	return matches, false
end

