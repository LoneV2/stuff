	local spiritColor = CachedSpiritBox and Color3.fromRGB(85, 215, 130) or Color3.fromRGB(205, 95, 95)
	SpiritBox.Text = spiritStr
	SpiritBox.TextColor3 = spiritColor
	HUD_SpiritBox.Text = spiritStr
	HUD_SpiritBox.TextColor3 = spiritColor

	-- Ghost Type Resolution
	local detectedList = {}
	if CachedPrints then table.insert(detectedList, "Handprints") end
	if CachedOrb and not IsDoppelgangerDetected then table.insert(detectedList, "GhostOrb") end
	if CachedLaser then table.insert(detectedList, "LaserProjector") end
	if isEMF5 then table.insert(detectedList, "EMFLevel5") end
	if isFreezing then table.insert(detectedList, "FreezingTemperatures") end
	if CachedWither then table.insert(detectedList, "Wither") end
	if CachedSpiritBox then table.insert(detectedList, "SpiritBox") end
	if CachedWriting then table.insert(detectedList, "GhostWriting") end

	local candidates, isDoppel = ResolveGhostMatches(detectedList, CachedOrb, CachedWriting, CachedSpiritBox, isFreezing)
	local detectedGhostType = directGhostType
	if not detectedGhostType then
		if isDoppel then
			detectedGhostType = "Doppelganger (Fake Orb!)"
