local autoDepositOn = false
local isDepositing = false
local depositAtPercent = 100
local statusCardUI = nil
local storeSangRemote = game.ReplicatedStorage.InventoryRemotes:FindFirstChild("StoreSang")

local function getStats() return LocalPlayer:FindFirstChild("Stats") end
local function getSangCount() local s = getStats() local v = s and s:FindFirstChild("CurrentSanguinite") return v and v.Value or 0 end
local function getSangCap() local s = getStats() local v = s and s:FindFirstChild("SanguiniteCapacity") return v and v.Value or 100 end
local function getSangPercent() local cap = getSangCap() if cap <= 0 then return 0 end return math.floor((getSangCount() / cap) * 100) end
local function getDepositDoor() local bell = WS:FindFirstChild("DivingBell") local storage = bell and bell:FindFirstChild("SangStorage") return storage and storage:FindFirstChild("InteractPart") end

local function updateStatusText(txt)
    if statusCardUI and statusCardUI.SetDesc then
        pcall(statusCardUI.SetDesc, statusCardUI, txt)
    end
end

local function depositNow(onStatus)
    if not localRoot then return end
    local door = getDepositDoor()
    if not door then
        if onStatus then onStatus("Deposit door not found!") end
        return
    end

    local myOldPos = localRoot.CFrame
    if onStatus then onStatus("Teleporting to deposit...") end
    localRoot.CFrame = door.CFrame + Vector3.new(0, 2, 2)
    task.wait(0.35)

    if onStatus then onStatus("Selling Sanguinite...") end
    if storeSangRemote then storeSangRemote:FireServer() end
    task.wait(0.45)

    if localRoot then localRoot.CFrame = myOldPos end
    task.wait(0.20)
    if onStatus then onStatus("Done! Current Sang: " .. getSangPercent() .. "%") end
end

