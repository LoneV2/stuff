-- safe bell interior
local function getSafeBellPos()
    local bell = WS:FindFirstChild("DivingBell")
    if not bell then return nil end
    local storage = bell:FindFirstChild("SangStorage")
    local interactPart = storage and storage:FindFirstChild("InteractPart")
    if interactPart then return interactPart.CFrame + Vector3.new(0, 2.5, 3.5) end

    local shop = bell:FindFirstChild("ShopHatch")
    if shop then return shop.CFrame + Vector3.new(3, 2.5, 0) end

    local core = bell.PrimaryPart or bell:FindFirstChildWhichIsA("BasePart")
    if core then return core.CFrame + Vector3.new(-8, 5, -8) end
    return nil
end

local function tpTo(target, heightOffset)
    if not localRoot then return end
    local yOff = heightOffset or 3.0
    if typeof(target) == "CFrame" then
        localRoot.CFrame = target + Vector3.new(0, yOff, 0)
    elseif typeof(target) == "Vector3" then
        localRoot.CFrame = CFrame.new(target + Vector3.new(0, yOff, 0))
    elseif typeof(target) == "Instance" then
        local part = (target:IsA("Model") and (target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart"))) or (target:IsA("BasePart") and target)
        if part then
            local rayP = RaycastParams.new()
            if localChar then rayP.FilterDescendantsInstances = { localChar } end
            local hit = WS:Raycast(part.Position + Vector3.new(0, 15, 0), Vector3.new(0, -25, 0), rayP)
            if hit and hit.Position then
                localRoot.CFrame = CFrame.new(hit.Position + Vector3.new(0, yOff, 0))
            else
                localRoot.CFrame = part.CFrame + Vector3.new(0, math.max(yOff, 4.5), 0)
            end
        end
    end
end

-- click tp
local clickTpOn = false
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

State:AddConnection(UIS.InputBegan:Connect(function(input, gpe)
    if gpe or not clickTpOn or isGuiOpen then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
        local mousePos = UIS:GetMouseLocation()
