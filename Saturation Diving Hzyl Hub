-- ============================================================================
-- Toggle Handler
-- ============================================================================

local isToggling = false
local function handleToggle()
    if isToggling or not Window then return end
    isToggling = true

    if isGuiOpen then
        if Window.Close then Window:Close() end
        isGuiOpen = false
        UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
    else
        if Window.Open then Window:Open() end
        isGuiOpen = true
        UIS.MouseBehavior = Enum.MouseBehavior.Default
        UIS.MouseIconEnabled = true
    end

    task.wait(0.20)
    isToggling = false
end

State:AddConnection(UIS.InputBegan:Connect(function(input, gpe)
    if UIS:GetFocusedTextBox() then return end
    local name = input.KeyCode.Name
    if name == guiKey or (#guiKey == 1 and name:lower() == guiKey:lower()) then
        handleToggle()
    end
end))

WindUI:Notify({
    Title = "Hzyl Hub Ready",
    Content = "Press " .. guiKey .. " to toggle the hub.",
    Duration = 5,
    Icon = "check"
})
