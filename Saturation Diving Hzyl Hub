                        end
                    end
                end
            end

            for target, data in pairs(State.WorldESP) do
                if not target or not target.Parent then
                    removeWorldEsp(target)
                elseif data.Label then
                    local part = (target:IsA("Model") and (target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart"))) or (target:IsA("BasePart") and target)
                    if part then
                        local dist = math.floor((part.Position - myPos).Magnitude)
                        if dist ~= data.LastDist then
