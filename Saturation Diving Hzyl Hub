local fullbrightOn = false
local brightMultiplier = 1.2
local defaultBright = Lighting.Brightness
local defaultClock = Lighting.ClockTime
local defaultShadows = Lighting.GlobalShadows
local defaultAmbient = Lighting.Ambient
local defaultOutdoor = Lighting.OutdoorAmbient
local defaultExposure = Lighting.ExposureCompensation

local noFogOn = false
local defaultFogEnd = Lighting.FogEnd
local defaultFogStart = Lighting.FogStart

local noBlurOn = false
local grayAmbient = Color3.fromRGB(130, 130, 130)

-- lighting loop
State:AddConnection(RS.RenderStepped:Connect(function()
    if fullbrightOn then
        if Lighting.Brightness ~= brightMultiplier then Lighting.Brightness = brightMultiplier end
        if Lighting.ClockTime ~= 14 then Lighting.ClockTime = 14 end
        if Lighting.ExposureCompensation ~= 0 then Lighting.ExposureCompensation = 0 end
        if Lighting.GlobalShadows ~= false then Lighting.GlobalShadows = false end
        if Lighting.Ambient ~= grayAmbient then Lighting.Ambient = grayAmbient end
        if Lighting.OutdoorAmbient ~= grayAmbient then Lighting.OutdoorAmbient = grayAmbient end
    end

    if noFogOn then
        if Lighting.FogEnd ~= 1e9 then Lighting.FogEnd = 1e9 end
        if Lighting.FogStart ~= 0 then Lighting.FogStart = 0 end
        for _, child in ipairs(Lighting:GetChildren()) do
            if child:IsA("Atmosphere") and child.Density ~= 0 then
                child.Density = 0
                child.Haze = 0
                child.Glare = 0
                child.Offset = 0
            end
        end
    end

    if noBlurOn then
        for _, effect in ipairs(Lighting:GetChildren()) do
            if (effect:IsA("BlurEffect") or effect:IsA("DepthOfFieldEffect")) and effect.Enabled then
                effect.Enabled = false
            end
        end
        if Camera then
            for _, effect in ipairs(Camera:GetChildren()) do
                if (effect:IsA("BlurEffect") or effect:IsA("DepthOfFieldEffect")) and effect.Enabled then
                    effect.Enabled = false
                end
            end
        end
    end
end))

local function resetLighting()
    Lighting.Brightness = defaultBright
    Lighting.ClockTime = defaultClock
    Lighting.GlobalShadows = defaultShadows
    Lighting.Ambient = defaultAmbient
    Lighting.OutdoorAmbient = defaultOutdoor
    Lighting.ExposureCompensation = defaultExposure
    Lighting.FogEnd = defaultFogEnd
    Lighting.FogStart = defaultFogStart

    local atm = Lighting:FindFirstChildOfClass("Atmosphere")
    if atm then atm.Density = 0.72 atm.Haze = 9 atm.Glare = 9 end

    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("BlurEffect") or effect:IsA("DepthOfFieldEffect") then
            effect.Enabled = true
        end
    end
end

