-- pickaxe power buff
local function applyPickaxePowerBuffs()
    pcall(function()
        local items = game.ReplicatedStorage:FindFirstChild("IngameItems")
        if items then
            for _, pName in ipairs({"Pickaxe", "Pickaxe2", "Pickaxe3"}) do
                local folder = items:FindFirstChild(pName)
                if folder then
                    folder:SetAttribute("PickaxePower", 12)
                end
            end
        end
    end)
end
task.spawn(applyPickaxePowerBuffs)

local function getSwingHooks()
    cachedUseItem = nil
    cachedMouse1Func = nil
    cachedDebounceIdx = nil
    applyPickaxePowerBuffs()
    if not getgc then return end

    local gc = getgc()
    for i = 1, #gc do
        local obj = gc[i]
        if typeof(obj) == "function" and islclosure(obj) then
            local info = debug.getinfo(obj)
            if not cachedUseItem and info.name == "useEquippedItem" and info.source and info.source:find("InventoryManager") then
                cachedUseItem = obj
            end
            if not cachedMouse1Func and info.name == "Mouse1" and info.source and info.source:find("ItemScript") then
                cachedMouse1Func = obj
                local upvs = debug.getupvalues(obj)
                for idx, val in pairs(upvs) do
                    if typeof(val) == "number" then
                        cachedDebounceIdx = idx
                        break
                    end
                end
            end
        end
        if cachedUseItem and cachedMouse1Func and cachedDebounceIdx then break end
    end
end

task.spawn(getSwingHooks)
State:AddConnection(LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.4)
    applyPickaxePowerBuffs()
    getSwingHooks()
    if walkspeedOn then applySpeed() end
    if flyOn then startFly() end
end))

-- hit aim vector
local function getBestHitDirection(camPos)
    -- monsters
    local monsterFolder = WS:FindFirstChild("CurrentMonsters")
    if monsterFolder then
        local bestMonster, bestMDist = nil, 14
        for _, m in ipairs(monsterFolder:GetChildren()) do
            local part = (m:IsA("Model") and (m.PrimaryPart or m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildWhichIsA("BasePart"))) or (m:IsA("BasePart") and m)
            if part then
                local d = (part.Position - camPos).Magnitude
                if d < bestMDist then
                    bestMDist = d
                    bestMonster = part
                end
            end
        end
        if bestMonster then
            return (bestMonster.Position - camPos).Unit * 12
        end
    end

    -- veins
    local veinsFolder = WS:FindFirstChild("LocalSanguiniteObjectiveAnchors")
    if veinsFolder then
        local bestVein, bestVDist = nil, 16
        for _, vein in ipairs(veinsFolder:GetChildren()) do
            local part = (vein:IsA("Model") and (vein.PrimaryPart or vein:FindFirstChildWhichIsA("BasePart"))) or (vein:IsA("BasePart") and vein)
            if part then
                local d = (part.Position - camPos).Magnitude
                if d < bestVDist then
                    bestVDist = d
                    bestVein = part
                end
            end
        end
        if bestVein then
            return (bestVein.Position - camPos).Unit * 10
        end
    end

    return Camera and (Camera.CFrame.LookVector * 10) or Vector3.new(0, 0, -10)
end

local function swingOnce()
    if not cachedUseItem or not cachedMouse1Func then
        getSwingHooks()
    end

    -- clear debounce
    if cachedMouse1Func and cachedDebounceIdx then
        debug.setupvalue(cachedMouse1Func, cachedDebounceIdx, 0)
    end
    if cachedUseItem then
        pcall(cachedUseItem)
    end

    -- direct hit packet
    if fastMiningOn and requestItemActionRemote and Camera then
        local camPos = Camera.CFrame.Position
        local dir = getBestHitDirection(camPos)
        requestItemActionRemote:FireServer("PickaxeMine", {
            Origin = camPos,
            Direction = dir,
            Power = 12
        })
    end
end

local function runSwingLoop()
    if swingLoopActive or not autoSwingOn or isGuiOpen then return end
    swingLoopActive = true
    State:AddThread(task.spawn(function()
        while isMouseDown and autoSwingOn and not isGuiOpen do
            swingOnce()
            task.wait(swingSpeed)
        end
        swingLoopActive = false
    end))
end

State:AddConnection(UIS.InputBegan:Connect(function(input, gpe)
    if gpe or isGuiOpen then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isMouseDown = true
        runSwingLoop()
    end
end))

State:AddConnection(UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isMouseDown = false
    end
end))

