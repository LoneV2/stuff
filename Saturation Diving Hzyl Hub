-- fly
local flyOn = false
local flySpeed = 50
local flyKey = "C"
local flyGyro, flyVel, flyLoop = nil, nil, nil
local flyToggleUI = nil
local moveKeys = { W = 0, S = 0, A = 0, D = 0, Up = 0, Down = 0 }

local function startFly()
    if not localRoot or not localHum then return end
    if flyGyro then pcall(flyGyro.Destroy, flyGyro) end
    if flyVel then pcall(flyVel.Destroy, flyVel) end

    flyGyro = Instance.new("BodyGyro")
    flyGyro.P = 9e4
    flyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyGyro.CFrame = localRoot.CFrame
    flyGyro.Parent = localRoot

    flyVel = Instance.new("BodyVelocity")
    flyVel.Velocity = Vector3.zero
    flyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyVel.Parent = localRoot

    localHum.PlatformStand = true

    if flyLoop then flyLoop:Disconnect() end
    flyLoop = State:AddConnection(RS.RenderStepped:Connect(function()
        if not flyOn or not localRoot or not localHum or not localRoot.Parent then return end
        localHum.PlatformStand = true
        flyGyro.CFrame = Camera.CFrame

        local dir = Vector3.zero
        local x = moveKeys.D + moveKeys.A
        local y = moveKeys.Up + moveKeys.Down
        local z = moveKeys.W + moveKeys.S

        if x ~= 0 or y ~= 0 or z ~= 0 then
            dir = (Camera.CFrame.LookVector * z + Camera.CFrame.RightVector * x + Vector3.new(0, y, 0)).Unit
        elseif localHum.MoveDirection.Magnitude > 0 then
            dir = localHum.MoveDirection
        end

        flyVel.Velocity = dir * flySpeed
    end))
end

local function stopFly()
    if localHum then localHum.PlatformStand = false end
    if flyGyro then pcall(flyGyro.Destroy, flyGyro) flyGyro = nil end
    if flyVel then pcall(flyVel.Destroy, flyVel) flyVel = nil end
    if flyLoop then flyLoop:Disconnect() flyLoop = nil end
end

local function toggleFly(val)
    flyOn = val
    if val then startFly() else stopFly() end
end

State:AddConnection(UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    local k = input.KeyCode
    if k == Enum.KeyCode.W then moveKeys.W = 1
    elseif k == Enum.KeyCode.S then moveKeys.S = -1
    elseif k == Enum.KeyCode.A then moveKeys.A = -1
    elseif k == Enum.KeyCode.D then moveKeys.D = 1
    elseif k == Enum.KeyCode.Space or k == Enum.KeyCode.E then moveKeys.Up = 1
    elseif k == Enum.KeyCode.LeftShift or k == Enum.KeyCode.Q then moveKeys.Down = -1
    end

    local name = k.Name
    if name == flyKey or (#flyKey == 1 and name:lower() == flyKey:lower()) then
        toggleFly(not flyOn)
        if flyToggleUI and flyToggleUI.Set then
            flyToggleUI:Set(flyOn)
        end
    end
end))

State:AddConnection(UIS.InputEnded:Connect(function(input)
    local k = input.KeyCode
    if k == Enum.KeyCode.W then moveKeys.W = 0
    elseif k == Enum.KeyCode.S then moveKeys.S = 0
    elseif k == Enum.KeyCode.A then moveKeys.A = 0
    elseif k == Enum.KeyCode.D then moveKeys.D = 0
    elseif k == Enum.KeyCode.Space or k == Enum.KeyCode.E then moveKeys.Up = 0
    elseif k == Enum.KeyCode.LeftShift or k == Enum.KeyCode.Q then moveKeys.Down = 0
    end
end))

