-- colors
local CRIMSON_OUTLINE = Color3.fromRGB(220, 20, 60)
local PLAYER_COLOR = Color3.fromRGB(56, 189, 248)
local BELL_COLOR = Color3.fromRGB(56, 189, 248)
local VEIN_COLOR = Color3.fromRGB(250, 204, 21)

local function isDumbProp(obj)
    if not obj or not obj.Name then return false end
    local n = obj.Name:lower()
    return n:find("chillbrine") ~= nil or n:find("chill_brine") ~= nil
end

local function getMonsterName(obj)
    if not obj or not obj.Name then return "Monster" end
    local n = obj.Name:lower()
    if n:find("hook") then return "Fishing Hook" end
    return obj.Name
end

local function addHighlight(target, fillColor, outlineColor, name)
    local old = target:FindFirstChild(name)
    if old then old:Destroy() end

    local h = Instance.new("Highlight")
    h.Name = name
    h.FillTransparency = 0.85
    h.FillColor = fillColor
    h.OutlineTransparency = 0
    h.OutlineColor = outlineColor or Color3.fromRGB(255, 255, 255)
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Adornee = target
    h.Parent = target
    return h
end

local function addBillboard(target, name, text, hexColor, offset)
    local root = (target:IsA("Model") and (target.PrimaryPart or target:FindFirstChild("HumanoidRootPart") or target:FindFirstChildWhichIsA("BasePart"))) or (target:IsA("BasePart") and target)
    if not root then return nil, nil end

    local old = root:FindFirstChild(name)
    if old then old:Destroy() end

    local bb = Instance.new("BillboardGui")
    bb.Name = name
    bb.Size = UDim2.new(0, 180, 0, 22)
    bb.StudsOffset = offset or Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = 8000
    bb.Adornee = root
    bb.Parent = root

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.TextStrokeTransparency = 0.2
    lbl.Font = Enum.Font.FredokaOne
    lbl.TextSize = 12
    lbl.RichText = true
    lbl.Text = string.format("<font color='#%s'><b>%s</b></font>", hexColor, text)
    lbl.Parent = bb
    return bb, lbl
end

-- player esp
local function attachPlayerEsp(char, player)
    if not playerEspOn or not char or char == localChar then return end
    local col = (player.Team and player.TeamColor.Color) or PLAYER_COLOR
    local h = addHighlight(char, col, Color3.fromRGB(255, 255, 255), "Player_ESPHighlight")
    local b, lbl = addBillboard(char, "Player_ESPBillboard", player.DisplayName or player.Name, "38bdf8", Vector3.new(0, 3.2, 0))
    State.PlayerESP[char] = { Highlight = h, Billboard = b, Label = lbl, Player = player, Target = char, LastDist = -1, LastHP = -1 }
end

local function removePlayerEsp(char)
    local data = State.PlayerESP[char]
    if data then
        if data.Highlight then pcall(data.Highlight.Destroy, data.Highlight) end
        if data.Billboard then pcall(data.Billboard.Destroy, data.Billboard) end
        State.PlayerESP[char] = nil
    end
end

-- monster esp
local function attachMonsterEsp(character)
    if not monsterEspOn or not character or character == localChar then return end
    if Players:GetPlayerFromCharacter(character) then return end
    if isDumbProp(character) or State.MonsterESP[character] then return end

    local name = getMonsterName(character)
    local h = addHighlight(character, CRIMSON_OUTLINE, CRIMSON_OUTLINE, "NPC_ESPHighlight")
    local b, lbl = addBillboard(character, "Monster_ESPBillboard", name, "dc143c", Vector3.new(0, 3.5, 0))
    State.MonsterESP[character] = { Highlight = h, Billboard = b, Label = lbl, BaseName = name, Target = character, LastDist = -1, LastHP = -1 }
end

local function removeMonsterEsp(character)
    local data = State.MonsterESP[character]
    if data then
        if data.Highlight then pcall(data.Highlight.Destroy, data.Highlight) end
        if data.Billboard then pcall(data.Billboard.Destroy, data.Billboard) end
        State.MonsterESP[character] = nil
    end
end

-- scan npcs
local function scanAllNPCs()
    if not monsterEspOn then return end

    for _, item in ipairs(WS:GetDescendants()) do
        if item:IsA("Humanoid") and item.Parent then
            attachMonsterEsp(item.Parent)
        end
    end

    local hooks = WS:FindFirstChild("TheHooks")
    if hooks then
        for _, h in ipairs(hooks:GetChildren()) do
            attachMonsterEsp(h)
        end
    end
    for _, item in ipairs(WS:GetChildren()) do
        if item.Name:lower():find("hook") and item ~= hooks then
            attachMonsterEsp(item)
        end
    end
end

-- dynamic spawn listener
State:AddConnection(WS.DescendantAdded:Connect(function(descendant)
    if not monsterEspOn then return end

    if descendant:IsA("Humanoid") then
        task.defer(function()
            if descendant.Parent then
                attachMonsterEsp(descendant.Parent)
            end
        end)
    elseif descendant.Name:lower():find("hook") or (descendant.Parent and descendant.Parent.Name == "TheHooks") then
        task.defer(function()
            attachMonsterEsp(descendant)
        end)
    end
end))

-- world esp
local function attachWorldEsp(target, label, color)
    if not target or not target.Parent or State.WorldESP[target] then return end
    local h = addHighlight(target, color, Color3.fromRGB(255, 255, 255), "World_ESPHighlight")
    local b, lbl = addBillboard(target, "World_ESPBillboard", label, color:ToHex(), Vector3.new(0, 3.5, 0))
    State.WorldESP[target] = { Highlight = h, Billboard = b, Label = lbl, BaseText = label, ColorHex = color:ToHex(), Target = target, LastDist = -1 }
end

local function removeWorldEsp(target)
    local data = State.WorldESP[target]
