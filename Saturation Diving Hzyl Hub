-- Instant Interact
-- ============================================================================

local instantInteractOn = true

local function applyInstantInteract()
    if not getgc then return end
    local gc = getgc()
    for i = 1, #gc do
        local obj = gc[i]
        if typeof(obj) == "function" and islclosure(obj) then
            local info = debug.getinfo(obj)
            if info.source and info.source:find("InventoryManager") then
                local upvs = debug.getupvalues(obj)
                for idx, val in pairs(upvs) do
                    if typeof(val) == "table" then
                        for k, v in pairs(val) do
                            if typeof(v) == "table" and (v.HoldDuration ~= nil or v.HoldToActivate ~= nil) then
                                if instantInteractOn then
                                    v.HoldToActivate = false
                                    v.HoldDuration = 0
                                else
                                    v.HoldToActivate = true
                                    v.HoldDuration = 1.1
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- prompts
    for _, p in ipairs(WS:GetDescendants()) do
        if p:IsA("ProximityPrompt") then
            if instantInteractOn then
                if not p:GetAttribute("OriginalHold") then
                    p:SetAttribute("OriginalHold", p.HoldDuration)
                end
                p.HoldDuration = 0
            else
                local orig = p:GetAttribute("OriginalHold")
                if orig then p.HoldDuration = orig end
            end
        end
    end
end

task.spawn(applyInstantInteract)
State:AddConnection(LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if instantInteractOn then applyInstantInteract() end
end))

State:AddConnection(WS.DescendantAdded:Connect(function(desc)
    if instantInteractOn and desc:IsA("ProximityPrompt") then
        task.defer(function()
            if not desc:GetAttribute("OriginalHold") then
                desc:SetAttribute("OriginalHold", desc.HoldDuration)
            end
            desc.HoldDuration = 0
        end)
    end
end))

