                                local hpText = hp > 0 and string.format(" <font color='#86efac'>[%d HP]</font>", hp) or ""
                                data.Label.Text = string.format("<font color='#38bdf8'><b>%s</b></font>%s <font color='#fde047'>[%dm]</font>", data.Player.DisplayName or data.Player.Name, hpText, dist)
                            end
                        end
                    end
                end
            end

            -- update monsters
            if monsterEspOn then
                for char, data in pairs(State.MonsterESP) do
                    if not char or not char.Parent then
                        removeMonsterEsp(char)
                    elseif data.Label then
                        local root = (char:IsA("Model") and (char.PrimaryPart or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart"))) or (char:IsA("BasePart") and char)
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if root then
                            local dist = math.floor((root.Position - myPos).Magnitude)
                            local hp = (hum and hum.Health > 0) and math.floor(hum.Health) or 0
                            if dist ~= data.LastDist or hp ~= data.LastHP then
                                data.LastDist = dist
                                data.LastHP = hp
                                local hpText = hp > 0 and string.format(" <font color='#93c5fd'>[%d HP]</font>", hp) or ""
                                data.Label.Text = string.format("<font color='#dc143c'><b>%s</b></font>%s <font color='#fde047'>[%dm]</font>", data.BaseName, hpText, dist)
