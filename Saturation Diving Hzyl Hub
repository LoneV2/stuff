            if data.Brightness ~= nil and UI.Brightness then UI.Brightness:Set(data.Brightness) end
            if data.NoFog ~= nil and UI.NoFog then UI.NoFog:Set(data.NoFog) end
            if data.NoBlur ~= nil and UI.NoBlur then UI.NoBlur:Set(data.NoBlur) end
            if data.MonsterESP ~= nil and UI.MonsterESP then UI.MonsterESP:Set(data.MonsterESP) end
            if data.PlayerESP ~= nil and UI.PlayerESP then UI.PlayerESP:Set(data.PlayerESP) end
            if data.DivingBellESP ~= nil and UI.DivingBellESP then UI.DivingBellESP:Set(data.DivingBellESP) end
            if data.VeinsESP ~= nil and UI.VeinsESP then UI.VeinsESP:Set(data.VeinsESP) end
            if data.ClickTP ~= nil and UI.ClickTP then UI.ClickTP:Set(data.ClickTP) end
            if data.AutoDeposit ~= nil and UI.AutoDeposit then UI.AutoDeposit:Set(data.AutoDeposit) end
            if data.DepositThreshold ~= nil and UI.DepositThreshold then UI.DepositThreshold:Set(data.DepositThreshold) end
            if data.FastMining ~= nil and UI.FastMining then UI.FastMining:Set(data.FastMining) end
            if data.InstantInteract ~= nil and UI.InstantInteract then UI.InstantInteract:Set(data.InstantInteract) end
            if data.HoldSwing ~= nil and UI.HoldSwing then UI.HoldSwing:Set(data.HoldSwing) end
            if data.HoldSwingInterval ~= nil and UI.HoldSwingInterval then UI.HoldSwingInterval:Set(data.HoldSwingInterval) end
            if data.GuiKey ~= nil and UI.GuiKey then UI.GuiKey:Set(data.GuiKey) end
            if data.Theme ~= nil and WindUI.SetTheme then
                currentTheme = data.Theme
                WindUI:SetTheme(data.Theme)
                if UI.ThemeSelect and UI.ThemeSelect.Select then
                    UI.ThemeSelect:Select(data.Theme)
                end
            end
        end)

        WindUI:Notify({Title="Config", Content="Loaded profile: " .. activeConfigName, Duration=3, Icon="check"})
    end
})

