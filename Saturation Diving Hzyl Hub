-- state manager
local State = {
    Connections = {},
    Threads = {},
    PlayerESP = {},
    MonsterESP = {},
    WorldESP = {},
    Window = nil
}

function State:AddConnection(conn)
    if conn and typeof(conn) == "RBXScriptConnection" then
        table.insert(self.Connections, conn)
    end
    return conn
end

function State:AddThread(thread)
    if thread and typeof(thread) == "thread" then
        table.insert(self.Threads, thread)
    end
    return thread
end

function State:Destroy()
    -- disconnect events
    for _, conn in ipairs(self.Connections) do
        if conn and conn.Connected then
            pcall(conn.Disconnect, conn)
        end
    end
    table.clear(self.Connections)

    -- stop threads
    for _, th in ipairs(self.Threads) do
        pcall(task.cancel, th)
    end
    table.clear(self.Threads)

    -- clear esp
    for _, item in pairs(self.PlayerESP) do
        if item.Highlight then pcall(item.Highlight.Destroy, item.Highlight) end
        if item.Billboard then pcall(item.Billboard.Destroy, item.Billboard) end
    end
    table.clear(self.PlayerESP)

    for _, item in pairs(self.MonsterESP) do
        if item.Highlight then pcall(item.Highlight.Destroy, item.Highlight) end
        if item.Billboard then pcall(item.Billboard.Destroy, item.Billboard) end
    end
    table.clear(self.MonsterESP)

    for _, item in pairs(self.WorldESP) do
        if item.Highlight then pcall(item.Highlight.Destroy, item.Highlight) end
        if item.Billboard then pcall(item.Billboard.Destroy, item.Billboard) end
    end
    table.clear(self.WorldESP)

    -- remove ui
    if self.Window and self.Window.Destroy then
        pcall(self.Window.Destroy, self.Window)
        self.Window = nil
    end
end

