-- Heartbeat / RenderStepped Engine Loops
RunService.RenderStepped:Connect(function()
	if _G.isEnabled then
		local isHolding = UIS:IsKeyDown(_G.lockKey) or UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) or _G.isHoldingLock;
		if isHolding or _G.aimLock then
			local ch, part = findTarget();
			if ch and part then
				local aimPos = getAimPos(part);
				local targetCFrame = VLO.aimOrigin.getAimCameraCFrame(aimPos);
				if _G.aimTween then
					local smoothTime = math.clamp(_G.aimSmooth or 0.15, 0.01, 1);
					cam.CFrame = cam.CFrame:Lerp(targetCFrame, math.clamp(1 / (smoothTime * 60), 0.05, 1));
				else
					cam.CFrame = targetCFrame;
				end;
			end;
		end;
	end;
	updateFOVCircle();
end);

RunService.Heartbeat:Connect(function()
	if _G.espEnabled then updateESP(); end;
end);

