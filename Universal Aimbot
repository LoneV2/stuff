VLO.aimOrigin.getAimCameraCFrame = function(targetPosition)
	local currentCamera = workspace.CurrentCamera or cam;
	if not currentCamera or typeof(targetPosition) ~= "Vector3" then return currentCamera and currentCamera.CFrame or CFrame.new(); end;
	local current = currentCamera.CFrame;
	local origin = current.Position;
	local targetVector = targetPosition - origin;
	if targetVector.Magnitude <= 0.0001 then return current; end;
	local point = getAimPoint();
	local ray = currentCamera:ViewportPointToRay(point.X, point.Y, 0);
	local fromDirection = ray.Direction.Unit;
	local toDirection = targetVector.Unit;
	local dot = math.clamp(fromDirection:Dot(toDirection), -1, 1);
	if dot >= 0.999999 then return current; end;
	local axis = fromDirection:Cross(toDirection);
	if axis.Magnitude <= 0.000001 then axis = fromDirection:Cross(current.UpVector); end;
	if axis.Magnitude <= 0.000001 then return current; end;
	local delta = CFrame.fromAxisAngle(axis.Unit, math.acos(dot));
	return CFrame.new(origin) * delta * current.Rotation;
end;

-- Raycast / Line of Sight Check
local function goodPart(p)
	if not p or not p:IsA("BasePart") or p.Transparency >= 0.95 or p.CanQuery == false or p.CanCollide == false then return false; end;
	return true;
end;
local function clearLOS(targetPart)
	if not targetPart then return false; end;
	local origin = cam.CFrame.Position;
	local dir = targetPart.Position - origin;
	local ignore = { plr.Character, targetPart.Parent };
	local params = RaycastParams.new();
	params.FilterType = Enum.RaycastFilterType.Blacklist;
	params.FilterDescendantsInstances = ignore;
	params.IgnoreWater = true;
	local maxHops = 10;
	local curOrigin = origin;
	local remaining = dir;
	for _ = 1, maxHops do
		local r = workspace:Raycast(curOrigin, remaining, params);
		if not r then return true; end;
		local hit = r.Instance;
		if not goodPart(hit) or hit:IsDescendantOf(targetPart.Parent) then
			table.insert(ignore, hit);
			params.FilterDescendantsInstances = ignore;
			curOrigin = r.Position + remaining.Unit * 0.01;
			remaining = origin + dir - curOrigin;
		else
			return false;
		end;
	end;
	return false;
end;

-- Target Resolution & Body Parts
local function getHumanoid(m)
	if not m or not m:IsA("Model") then return nil; end;
	return m:FindFirstChildOfClass("Humanoid");
end;
local function getPart(m, name)
	if not m or not m:IsA("Model") then return nil; end;
	local p = m:FindFirstChild(name, true);
	if p and p:IsA("BasePart") then return p; end;
	return m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Torso") or m:FindFirstChild("Head");
end;

local function getPredictedAimPos(part)
	local base = part.Position;
	local camPos = cam and cam.CFrame.Position or base;
	local dist = (base - camPos).Magnitude;
	local lead = math.clamp(tonumber(_G.aimLead) or 0.12, 0, 1);
	if dist < 14 or lead <= 0 then return base; end;
	local root = part.Parent and (part.Parent:FindFirstChild("HumanoidRootPart") or part);
	local vel = root and (root.AssemblyLinearVelocity or root.Velocity) or Vector3.zero;
	if vel.Magnitude < 1 then return base; end;
	local distScale = math.clamp((dist - 14) / 170, 0, 1);
	local off = vel * lead * distScale;
	return base + off;
end;

local function getDropCompensatedAimPos(pos)
	if not _G.aimDropCompensation then return pos; end;
	local strength = math.clamp(tonumber(_G.aimDropStrength) or 1, 0, 3);
	if strength <= 0 then return pos; end;
	local distance = (pos - cam.CFrame.Position).Magnitude;
	if distance <= 25 then return pos; end;
	local scaledDistance = (distance - 25) / 100;
	local rise = scaledDistance * scaledDistance * 1.2 * strength;
	return pos + Vector3.new(0, math.min(rise, 60), 0);
end;

local function getAimPos(part)
	local pos = _G.aimPredict and getPredictedAimPos(part) or part.Position;
	if _G.aimTargetMode == "Head" and tostring(part.Name):lower():find("head") then
		pos += Vector3.new(0, 0.2, 0);
	end;
	return getDropCompensatedAimPos(pos);
end;

local function isEnemy(op)
	if not _G.teamCheck then return true; end;
	return op.Team ~= nil and plr.Team ~= nil and op.Team ~= plr.Team;
end;

local function isAlive(ch)
	if not _G.aliveCheck then return true; end;
	local hum = getHumanoid(ch);
	return hum ~= nil and hum.Health > 0;
end;

local function getScanAimPart(ch)
	local targetPartName = _G.aimTargetMode;
	if targetPartName == "Torso" then targetPartName = "UpperTorso"; end;
	if targetPartName == "Root" then targetPartName = "HumanoidRootPart"; end;
	local part = getPart(ch, targetPartName);
	if part and (not _G.wallCheck or clearLOS(part)) then
		return part;
	end;
	return getPart(ch, "HumanoidRootPart") or getPart(ch, "Head");
end;

local function findTarget()
	local near = nil;
	local nearPart = nil;
	local bestPrimary = math.huge;
	local mp = getAimPoint();
	local camPos = cam.CFrame.Position;
	local maxDistance = math.clamp(tonumber(_G.targetMaxDistance) or 2500, 100, 5000);
	local maxR = _G.aimRadius or 150;

	local candidates = {};
	local entityMode = _G.entMode;

	if entityMode == "Player" or entityMode == "Player/NPC" then
		for _, op in getPlrs() do
			local char = op.Character;
			if op ~= plr and char and isEnemy(op) and isAlive(char) then
				table.insert(candidates, char);
			end;
		end;
	end;
	if entityMode == "NPC" or entityMode == "Player/NPC" then
		for _, np in npc.get() do
			if isAlive(np) then table.insert(candidates, np); end;
		end;
	end;

	for _, ch in candidates do
		local part = getScanAimPart(ch);
		if part then
			local scr, on = cam:WorldToViewportPoint(part.Position);
			if on then
				local dist = (part.Position - camPos).Magnitude;
				if dist <= maxDistance then
					local sdist = (Vector2.new(scr.X, scr.Y) - mp).Magnitude;
					if _G.targetPriorityMode ~= "Crosshair" or sdist <= maxR then
						local primary = sdist;
						if _G.targetPriorityMode == "Distance" or _G.lockToNearest then primary = dist; end;
						if primary < bestPrimary then
							bestPrimary = primary;
							near = ch;
							nearPart = part;
						end;
					end;
				end;
			end;
		end;
	end;

	lastLockedCharacter = near;
	lastLockedPart = nearPart;
	return near, nearPart;
end;

