local function updateFOVCircle()
	if not fovCircleDrawing then return; end;
	if _G.fovCircleEnabled and _G.isEnabled then
		local pt = getAimPoint();
		fovCircleDrawing.Position = pt;
		fovCircleDrawing.Radius = math.clamp(tonumber(_G.aimRadius) or 150, 10, 500);
		fovCircleDrawing.Thickness = math.clamp(tonumber(_G.fovCircleThickness) or 2, 1, 8);
		fovCircleDrawing.Transparency = 1 - math.clamp(tonumber(_G.fovCircleAlpha) or 0.25, 0, 1);
		fovCircleDrawing.Color = Color3.fromRGB(202, 243, 255);
		fovCircleDrawing.Visible = true;
	else
