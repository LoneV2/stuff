	end;
end;

-- ESP Updates
local function updateESPText(p)
	local rec = espMap[p];
	if not rec or not rec.tx then return; end;
	local ch = p.Character;
	local hum = ch and getHumanoid(ch);
	local lines = {};
	if _G.espShowName then table.insert(lines, p.Name); end;
	if _G.espShowHP and hum then table.insert(lines, "HP: " .. math.floor(hum.Health)); end;
	if _G.espShowTeam and p.Team then table.insert(lines, p.Team.Name); end;
	if _G.espShowDistance and ch then
		local part = getPart(ch, "HumanoidRootPart");
		if part then table.insert(lines, "DIST: " .. math.floor((part.Position - cam.CFrame.Position).Magnitude)); end;
	end;
	rec.tx.Text = table.concat(lines, "\n");
	rec.tx.TextSize = _G.espTextSize or 14;
	rec.bb.Enabled = #lines > 0;
end;

local function espDetach(p)
	local rec = espMap[p];
	if not rec then return; end;
	if rec.hi and rec.hi.Parent then rec.hi:Destroy(); end;
	if rec.bb and rec.bb.Parent then rec.bb:Destroy(); end;
	espMap[p] = nil;
end;

local function espAttach(p)
	if not _G.espEnabled or p == plr or not p.Character then return; end;
	local ch = p.Character;
	if _G.teamCheck and not isEnemy(p) then return; end;
	if _G.aliveCheck and not isAlive(ch) then return; end;

	local rec = espMap[p] or {};
	if not rec.hi or not rec.hi.Parent then
		rec.hi = Instance.new("Highlight");
		rec.hi.Parent = uiRoot;
	end;
	rec.hi.Adornee = ch;
	rec.hi.FillColor = (_G.espTeamColor and p.TeamColor) and p.TeamColor.Color or Color3.fromRGB(117, 94, 255);
	rec.hi.FillTransparency = _G.espTransparency or 0.3;
	rec.hi.OutlineTransparency = _G.espOutlineTransparency or 0.12;
	rec.hi.DepthMode = _G.espAlwaysOnTop and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded;

	if not rec.bb or not rec.bb.Parent then
		rec.bb = Instance.new("BillboardGui");
		rec.bb.Size = UDim2.new(0, 140, 0, 50);
		rec.bb.StudsOffset = Vector3.new(0, 3, 0);
		rec.bb.AlwaysOnTop = true;
		rec.bb.Parent = uiRoot;

		rec.tx = Instance.new("TextLabel", rec.bb);
		rec.tx.Size = UDim2.new(1, 0, 1, 0);
		rec.tx.BackgroundTransparency = 1;
		rec.tx.TextColor3 = Color3.fromRGB(255, 255, 255);
		rec.tx.TextStrokeTransparency = 0.5;
		rec.tx.Font = Enum.Font.GothamBold;
	end;
	rec.bb.Adornee = getPart(ch, "Head");
	espMap[p] = rec;
	updateESPText(p);
end;

local function updateESP()
	if not _G.espEnabled then
		for p in espMap do espDetach(p); end;
		return;
	end;
	for _, p in getPlrs() do
		if p ~= plr and p.Character then espAttach(p); end;
	end;
end;

